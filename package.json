{
  "name": "teste-tecnico-lacrei-saude-qa",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint": "eslint . --ext .ts,.js",
    "lint:cypress": "eslint cypress --ext .ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "cy:run": "cypress run",
    "cy:critical": "npm run cy:run -- --env tags=@critical",
    "cy:validation": "npm run cy:run -- --env tags=@validation",
    "cy:regression": "npm run cy:run -- --env tags=@regression",
    "cy:all": "run-s --continue-on-error cy:critical cy:regression cy:validation",
    "generate-reports": "npx mochawesome-merge cypress/reports/json/*.json -o cypress/reports/report.json && npx marge cypress/reports/report.json --reportDir cypress/reports/html --inline",
    "load:cadastro": "tsx performance/cadastro.load.ts",
    "load:busca": "tsx performance/buscar-profissional.load.ts",
    "load:all": "npm-run-all --continue-on-error load:cadastro load:busca"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@faker-js/faker": "^10.4.0",
    "@types/node": "^25.9.1",
    "cypress": "^15.8.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^5.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "puppeteer": "^25.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1"
  },
  "dependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^24.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8"
  }
}
